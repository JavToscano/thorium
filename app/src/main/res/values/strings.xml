    <string name="about_catalog_title">Game catalog</string>
    <string name="about_catalog_text">Game names, regions and checksums come from the No-Intro DAT files, distributed by the libretro-database project under the Creative Commons Attribution-ShareAlike 4.0 license (creativecommons.org/licenses/by-sa/4.0). Thorium converted them into a compact database, and that converted data keeps the same license. No game files or download links are included.</string>
    <string name="about_covers_title">Cover art</string>
    <string name="about_covers_text">Cover images come from the libretro thumbnail server (thumbnails.libretro.com), where they are shared for RetroArch. Each image belongs to its respective rights holders.</string>
    <string name="about_libs_title">Open-source components</string>
    <string name="about_libs_text">Jetpack Compose, Room, Kotlin and kotlinx, OkHttp and Apache Commons Compress (Apache License 2.0); XZ for Java (0BSD).</string>
    <string name="settings_covers_title">Cover art</string>
    <string name="settings_covers_desc">Downloads each game\'s cover from thumbnails.libretro.com. Only the game\'s name is sent.</string>
